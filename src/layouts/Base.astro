---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
}

const { title, description, canonical, ogImage = '/og-image.png' } = Astro.props;
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).toString();
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-1VQ3TJV43Q"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-1VQ3TJV43Q');
  </script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
  <meta property="og:site_name" content="LinkWA" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Preconnect for performance -->
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" />

  <!-- Theme color -->
  <meta name="theme-color" content="#25D366" />

  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7295477262076788" crossorigin="anonymous"></script>
</head>
<body>

<!-- TOP AGENCY PROMO BANNER -->
<div style="background: #0f172a; border-bottom: 1px solid rgba(255, 255, 255, 0.08); color: rgba(255, 255, 255, 0.85); text-align: center; font-size: 13px; padding: 10px 16px; font-weight: 500; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; display: flex; align-items: center; justify-content: center; gap: 8px; flex-wrap: wrap; z-index: 1000; position: relative;">
  <span>Brought to you by <strong style="font-weight: 700; color: #fff;">Social Ninja's AI Agency</strong> — Need help automating or scaling your business?</span>
  <a href="https://socialninjas.in/contact" target="_blank" style="color: #5ba4f5; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; transition: color 0.2s;" onmouseover="this.style.color='#8ec2fc'" onmouseout="this.style.color='#5ba4f5'">Get Free Audit →</a>
</div>

<!-- NAV -->
<nav>
  <a class="logo" href="/">
    <div style="display: flex; align-items: center; justify-content: center;">
      <svg viewBox="0 0 24 24" fill="var(--gm)" style="width: 28px; height: 28px;">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        <path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2.07 21.5l4.432-1.343A9.956 9.956 0 0012 22c5.523 0 10-4.477 10-10S17.522 2 12 2zm0 18.182a8.173 8.173 0 01-4.168-1.143l-.3-.178-3.1.939.892-3.232-.196-.315A8.18 8.18 0 013.818 12c0-4.513 3.669-8.182 8.182-8.182 4.512 0 8.181 3.669 8.181 8.182 0 4.513-3.669 8.182-8.182 8.182z"/>
      </svg>
    </div>
    <span class="logo-name">Link<em>WA</em></span>
  </a>
  <div class="nav-right">
    <div class="nav-links">
      <a href="/" class={currentPath === '/' ? 'active' : ''}>Tool</a>
      <a href="/about" class={currentPath === '/about' ? 'active' : ''}>About</a>
      <a href="/contact" class={currentPath === '/contact' ? 'active' : ''}>Contact</a>
      <a href="/blog" class={Astro.url.pathname.startsWith('/blog') ? 'active' : ''}>Blog</a>
      <a href="/privacy" class={currentPath === '/privacy' ? 'active' : ''}>Privacy</a>
      <a href="/terms" class={currentPath === '/terms' ? 'active' : ''}>Terms</a>
    </div>
    <div class="nav-live"><span class="dot"></span> No data stored</div>
    <span class="nav-pill">Free</span>
    
    <!-- Mobile Hamburger Toggle -->
    <button class="mobile-menu-btn" id="menuBtn" aria-label="Toggle Menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6" class="line1"></line>
        <line x1="3" y1="12" x2="21" y2="12" class="line2"></line>
        <line x1="3" y1="18" x2="21" y2="18" class="line3"></line>
      </svg>
    </button>
  </div>
</nav>

<!-- Mobile Sliding Drawer -->
<div class="mobile-drawer" id="mobileDrawer">
  <div class="drawer-links">
    <a href="/" class={currentPath === '/' ? 'active' : ''}>Home Tool</a>
    <a href="/about" class={currentPath === '/about' ? 'active' : ''}>About Us</a>
    <a href="/contact" class={currentPath === '/contact' ? 'active' : ''}>Contact Us</a>
    <a href="/blog" class={Astro.url.pathname.startsWith('/blog') ? 'active' : ''}>Blog Guides</a>
    <a href="/privacy" class={currentPath === '/privacy' ? 'active' : ''}>Privacy Policy</a>
    <a href="/terms" class={currentPath === '/terms' ? 'active' : ''}>Terms of Service</a>
  </div>
  
  <div class="drawer-promo-card">
    <div class="promo-title">Social Ninja's AI Agency</div>
    <div class="promo-text">We build automated client acquisition systems, custom chatbots, and manage high-converting Meta/Google ad campaigns.</div>
    <a href="https://socialninjas.in/contact" target="_blank" class="promo-btn">Get Free Growth Audit →</a>
  </div>
</div>

<script is:inline>
  const btn = document.getElementById('menuBtn');
  const drawer = document.getElementById('mobileDrawer');
  if (btn && drawer) {
    btn.addEventListener('click', () => {
      drawer.classList.toggle('open');
      btn.classList.toggle('active');
      document.body.style.overflow = drawer.classList.contains('open') ? 'hidden' : '';
    });
  }
</script>

<style>
/* Responsive Mobile Drawer CSS */
.mobile-menu-btn {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--ink);
  padding: 4px;
  z-index: 1100;
  margin-left: 10px;
}
.mobile-menu-btn svg {
  width: 22px;
  height: 22px;
}
.mobile-drawer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  padding: 100px 2rem 40px;
  transform: translateX(100%);
  transition: transform 0.4s cubic-bezier(0.32, 0.72, 0, 1);
  overflow-y: auto;
}
.mobile-drawer.open {
  transform: translateX(0);
}
.drawer-links {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  margin-bottom: 2rem;
}
.drawer-links a {
  font-family: var(--font-display);
  font-size: 24px;
  font-weight: 700;
  text-decoration: none;
  color: var(--ink2);
  letter-spacing: -0.5px;
}
.drawer-links a.active {
  color: var(--gm);
}
.drawer-promo-card {
  margin-top: auto;
  background: linear-gradient(135deg, #08101f, #0f1c3f);
  border-radius: 18px;
  padding: 22px;
  color: #fff;
  border: 1px solid rgba(255,255,255,0.08);
  box-shadow: 0 10px 30px rgba(8,16,31,0.25);
}
.promo-title {
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 700;
  margin-bottom: 6px;
  color: #5ba4f5;
}
.promo-text {
  font-size: 12.5px;
  color: rgba(255,255,255,0.65);
  line-height: 1.6;
  margin-bottom: 16px;
}
.promo-btn {
  display: block;
  background: linear-gradient(135deg, #2563eb, #5ba4f5);
  color: #fff !important;
  text-decoration: none;
  font-weight: 600;
  font-size: 13.5px;
  padding: 11px 18px;
  border-radius: 10px;
  text-align: center;
  box-shadow: 0 4px 16px rgba(91,164,245,0.3);
}

.mobile-menu-btn svg line {
  transform-origin: center;
  transition: transform 0.2s ease, opacity 0.2s ease;
}
.mobile-menu-btn.active .line1 {
  transform: translateY(6px) rotate(45deg);
}
.mobile-menu-btn.active .line2 {
  opacity: 0;
}
.mobile-menu-btn.active .line3 {
  transform: translateY(-6px) rotate(-45deg);
}

@media(max-width: 800px) {
  .nav-links { display: none !important; }
  .mobile-menu-btn { display: block !important; }
  .nav-live { display: none !important; }
}
</style>

<!-- PAGE CONTENT -->
<slot />

<!-- FOOTER -->
<footer>
  <div class="ft-inner">
    <div class="ft-logo">Link<em>WA</em></div>
    <div class="ft-links">
      <a href="/about">About Us</a>
      <a href="/contact">Contact Us</a>
      <a href="/blog">Blog</a>
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms & Conditions</a>
    </div>
  </div>
  <div class="ft-copy">
    © 2025 LinkWA · linkwa.in · Your phone number never leaves your browser · Powered by <a href="https://socialninjas.in" target="_blank" style="color: #5ba4f5; text-decoration: none; font-weight: 600;">Social Ninja's AI Agency</a>
  </div>
</footer>

<div class="toast" id="toast"></div>
<canvas id="exportCanvas"></canvas>

</body>
</html>
