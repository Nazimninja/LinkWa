<style>
.lang-item:hover, .drawer-lang-chip:hover {
  background: var(--gl) !important;
  color: var(--gm) !important;
}
.lang-item.active, .drawer-lang-chip.active {
  background: var(--gl) !important;
  color: var(--gm) !important;
  font-weight: 700 !important;
}
.drawer-lang-chip {
  padding: 6px 10px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  border: 1px solid var(--bd2);
  background: var(--bgl);
  color: var(--ink);
  transition: all 0.15s;
}
</style>

<script is:inline>
  const LANG_META = {
    en: { name: 'EN', flag: '🇺🇸' },
    es: { name: 'ES', flag: '🇪🇸' },
    pt: { name: 'PT', flag: '🇧🇷' },
    hi: { name: 'HI', flag: '🇮🇳' },
    id: { name: 'ID', flag: '🇮🇩' },
    fr: { name: 'FR', flag: '🇫🇷' },
    de: { name: 'DE', flag: '🇩🇪' },
    ar: { name: 'AR', flag: '🇸🇦' },
    it: { name: 'IT', flag: '🇮🇹' },
    tr: { name: 'TR', flag: '🇹🇷' }
  };

  function toggleLangDropdown(e) {
    if (e) e.stopPropagation();
    const menu = document.getElementById('langDropdownMenu');
    const arrow = document.getElementById('langArrow');
    if (menu) {
      const isShown = menu.style.display === 'block';
      menu.style.display = isShown ? 'none' : 'block';
      if (arrow) arrow.style.transform = isShown ? '' : 'rotate(180deg)';
    }
  }

  document.addEventListener('click', function() {
    const menu = document.getElementById('langDropdownMenu');
    const arrow = document.getElementById('langArrow');
    if (menu) menu.style.display = 'none';
    if (arrow) arrow.style.transform = '';
  });

  function changeSiteLang(langCode) {
    try {
      localStorage.setItem('linkwa_user_lang', langCode);
      const meta = LANG_META[langCode] || LANG_META.en;
      const flagEl = document.getElementById('currentLangFlag');
      const nameEl = document.getElementById('currentLangName');
      if (flagEl) flagEl.textContent = meta.flag;
      if (nameEl) nameEl.textContent = meta.name;
      
      document.querySelectorAll('.lang-item, .drawer-lang-chip').forEach(el => {
        el.classList.toggle('active', el.getAttribute('data-lang') === langCode);
      });

      const menu = document.getElementById('langDropdownMenu');
      if (menu) menu.style.display = 'none';
      const arrow = document.getElementById('langArrow');
      if (arrow) arrow.style.transform = '';

      if (window.location.pathname !== '/' && window.location.pathname !== '') {
        window.location.href = '/?lang=' + langCode;
        return;
      }

      const newUrl = langCode === 'en' ? '/' : '/?lang=' + langCode;
      window.history.replaceState({}, '', newUrl);

      if (typeof window.applyUiTranslation === 'function') {
        window.applyUiTranslation(langCode);
      }
    } catch (e) {
      console.error('Lang switch error:', e);
    }
  }

  // Set initial indicator on load
  document.addEventListener('DOMContentLoaded', function() {
    const saved = (new URLSearchParams(window.location.search).get('lang')) || localStorage.getItem('linkwa_user_lang') || 'en';
    const meta = LANG_META[saved] || LANG_META.en;
    const flagEl = document.getElementById('currentLangFlag');
    const nameEl = document.getElementById('currentLangName');
    if (flagEl) flagEl.textContent = meta.flag;
    if (nameEl) nameEl.textContent = meta.name;
    document.querySelectorAll('.lang-item, .drawer-lang-chip').forEach(el => {
      el.classList.toggle('active', el.getAttribute('data-lang') === saved);
    });
  });
</script>
</body>
