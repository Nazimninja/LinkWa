---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  lang?: string;
}

const { title, description, canonical, ogImage = '/og-image.png', lang = 'en' } = Astro.props;

// Ensure canonical URL always ends with a trailing slash for directory routes
let rawCanonical = canonical || new URL(Astro.url.pathname, Astro.site || 'https://linkwa.in').toString();
if (!rawCanonical.endsWith('/')) {
  const lastPathSegment = rawCanonical.split('/').pop() || '';
  if (!lastPathSegment.includes('.')) {
    rawCanonical = rawCanonical + '/';
  }
}
const canonicalURL = rawCanonical;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

