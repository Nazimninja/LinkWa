  function toggleLangDropdown(e) {
    if (e) e.stopPropagation();
    const menu = document.getElementById('langDropdownMenu');
    const arrow = document.getElementById('langArrow');
    if (menu) {
      const isShown = menu.style.display === 'block';
      menu.style.display = isShown ? 'none' : 'block';
      if (arrow) arrow.style.transform = isShown ? '' : 'rotate(180deg)';
    }
  }

  document.addEventListener('click', function() {
    const menu = document.getElementById('langDropdownMenu');
    const arrow = document.getElementById('langArrow');
    if (menu) menu.style.display = 'none';
    if (arrow) arrow.style.transform = '';
  });

  window.applyUiTranslation = function(code) {
    const dict = I18N_DICTIONARY[code] || I18N_DICTIONARY.en;
    if (!dict) return;

    // 1. Navigation links
    const nGen = document.getElementById('navLinkGen'); if (nGen) nGen.textContent = dict.navGen;
    const nAuto = document.getElementById('navLinkAuto'); if (nAuto) nAuto.textContent = dict.navAuto;
    const nBlog = document.getElementById('navLinkBlog'); if (nBlog) nBlog.textContent = dict.navBlog;
    const nAbout = document.getElementById('navLinkAbout'); if (nAbout) nAbout.textContent = dict.navAbout;
    const nContact = document.getElementById('navLinkContact'); if (nContact) nContact.textContent = dict.navContact;
    const nLive = document.getElementById('navLive'); if (nLive) nLive.innerHTML = '<span class="dot"></span> ' + dict.navLive;

    // 2. Hero Section
    const hChip = document.getElementById('heroChipText'); if (hChip) hChip.textContent = dict.heroChip;
    const hTitle = document.getElementById('heroTitle'); if (hTitle) hTitle.innerHTML = dict.heroTitle;
    const hSub = document.getElementById('heroSub'); if (hSub) hSub.textContent = dict.heroSub;
    const s1L = document.getElementById('stat1L'); if (s1L) s1L.textContent = dict.stat1L;
    const s2L = document.getElementById('stat2L'); if (s2L) s2L.textContent = dict.stat2L;
    const s3N = document.getElementById('stat3N'); if (s3N) s3N.textContent = dict.stat3N;
    const s3L = document.getElementById('stat3L'); if (s3L) s3L.textContent = dict.stat3L;

    // 3. Tabs
    const tBasic = document.getElementById('tabBtnBasic'); if (tBasic) tBasic.textContent = dict.tabBasic;
    const tUtm = document.getElementById('tabBtnUtm'); if (tUtm) tUtm.textContent = dict.tabUtm;
    const tMulti = document.getElementById('tabBtnMulti'); if (tMulti) tMulti.textContent = dict.tabMulti;
    const tGroup = document.getElementById('tabBtnGroup'); if (tGroup) tGroup.textContent = dict.tabGroup;

    // 4. Form inputs & labels
    const fTitle = document.getElementById('formCardTitle'); if (fTitle) fTitle.textContent = dict.formTitle;
    const fSub = document.getElementById('formCardSub'); if (fSub) fSub.textContent = dict.formSub;
    const pLbl = document.querySelector('label[for="phone"]'); if (pLbl) pLbl.textContent = dict.phoneLbl;
    const pHint = document.querySelector('#panel-basic .hint'); if (pHint) pHint.textContent = dict.phoneHint;
    const mLbl = document.querySelector('label[for="msg"]'); if (mLbl) mLbl.innerHTML = dict.msgLbl;
    const msgInput = document.getElementById('msg'); if (msgInput) msgInput.placeholder = dict.msgPh;

    const pills = document.querySelectorAll('.template-pills .pill-btn');
    if (pills && pills.length >= 3) {
      pills[0].textContent = dict.tplInquiry;
      pills[0].onclick = () => { if (typeof applyTemplate === 'function') applyTemplate(dict.tplInquiryText); };
      pills[1].textContent = dict.tplPricing;
      pills[1].onclick = () => { if (typeof applyTemplate === 'function') applyTemplate(dict.tplPricingText); };
      pills[2].textContent = dict.tplBooking;
      pills[2].onclick = () => { if (typeof applyTemplate === 'function') applyTemplate(dict.tplBookingText); };
    }

    const sLbl = document.querySelector('label[for="slug"]'); if (sLbl) sLbl.innerHTML = dict.slugLbl;
    const bGen = document.getElementById('btnGen'); if (bGen) { const s = bGen.querySelector('span'); if (s) s.textContent = dict.btnGen; }

    // 5. Output Preview Card
    const dTitle = document.getElementById('desktopCardTitle'); if (dTitle) dTitle.textContent = dict.deskTitle;
    const dSub = document.getElementById('desktopCardSub'); if (dSub) dSub.textContent = dict.deskSub;
    const cp = document.getElementById('cpbtn'); if (cp) cp.textContent = dict.cpbtn;
    const testBtn = document.getElementById('testbtn'); if (testBtn) testBtn.textContent = dict.testbtn;
    const shareBtn = document.getElementById('sharebtn'); if (shareBtn) shareBtn.textContent = dict.sharebtn;

    // 6. QR Code Studio Card
    const sTitle = document.getElementById('studioTitle'); if (sTitle) sTitle.textContent = dict.studioTitle;
    const sSub2 = document.getElementById('studioSub'); if (sSub2) sSub2.textContent = dict.studioSub;
    const dl = document.getElementById('dlbtn'); if (dl) dl.innerHTML = '<span>📥 ' + dict.dlbtn + '</span>';

    // 7. Auto-switch country code if user hasn't typed a phone number yet
    const phoneVal = (document.getElementById('phone')?.value || '').trim();
    if (!phoneVal && dict.cc) {
      const ccEl = document.getElementById('cc');
      if (ccEl && [...ccEl.options].some(o => o.value === dict.cc)) ccEl.value = dict.cc;
      const uccEl = document.getElementById('ucc');
      if (uccEl && [...uccEl.options].some(o => o.value === dict.cc)) uccEl.value = dict.cc;
    }

    // 8. Update current flag & label in navbar
    const curFlag = document.getElementById('currentLangFlag');
    const curName = document.getElementById('currentLangName');
    if (curFlag) curFlag.textContent = dict.flag || '🌐';
    if (curName) curName.textContent = dict.name || code.toUpperCase();

    // 9. Highlight active item in dropdown
    document.querySelectorAll('.lang-item, .drawer-lang-chip').forEach(el => {
      el.classList.toggle('active', el.getAttribute('data-lang') === code);
    });

    if (typeof live === 'function') live();
  };

  function changeSiteLang(langCode) {
    try {
      localStorage.setItem('linkwa_user_lang', langCode);

      const menu = document.getElementById('langDropdownMenu');
      if (menu) menu.style.display = 'none';
      const arrow = document.getElementById('langArrow');
      if (arrow) arrow.style.transform = '';

      if (window.location.pathname !== '/' && window.location.pathname !== '') {
        window.location.href = '/?lang=' + langCode;
        return;
      }

      const newUrl = langCode === 'en' ? '/' : '/?lang=' + langCode;
      window.history.replaceState({}, '', newUrl);

      window.applyUiTranslation(langCode);
    } catch (e) {
      console.error('Lang switch error:', e);
    }
  }

  // Auto-detect and apply language on initial page load
  document.addEventListener('DOMContentLoaded', function() {
    let saved = (new URLSearchParams(window.location.search).get('lang')) || localStorage.getItem('linkwa_user_lang');
    if (!saved && navigator.language) {
      const navL = navigator.language.toLowerCase();
      for (const k of Object.keys(I18N_DICTIONARY)) {
        if (navL.startsWith(k)) { saved = k; break; }
      }
    }
    saved = saved || 'en';
    window.applyUiTranslation(saved);
  });
</script>
