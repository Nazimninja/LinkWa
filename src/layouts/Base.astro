  <!-- Google tag (gtag.js) dataLayer stub -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-1VQ3TJV43Q');

    // Efficient non-blocking loader for third-party scripts (GA, SWG, AdSense)
    (function() {
      var loaded = false;
      function loadScripts() {
        if (loaded) return;
        loaded = true;

        // 1. Google Analytics
        var ga = document.createElement('script');
        ga.async = true;
        ga.src = 'https://www.googletagmanager.com/gtag/js?id=G-1VQ3TJV43Q';
        document.head.appendChild(ga);

        // 2. Google Reader Revenue Manager (SWG)
        var swg = document.createElement('script');
        swg.async = true;
        swg.src = 'https://news.google.com/swg/js/v1/swg-basic.js';
        swg.onload = function() {
          (self.SWG_BASIC = self.SWG_BASIC || []).push(function(basicSubscriptions) {
            basicSubscriptions.init({
              type: "NewsArticle",
              isPartOfType: ["Product"],
              isPartOfProductId: "CAow-uzHDA:openaccess",
              clientOptions: { theme: "light", lang: "en" }
            });
          });
        };
        document.head.appendChild(swg);

        // 3. Google AdSense
        var ads = document.createElement('script');
        ads.async = true;
        ads.crossOrigin = 'anonymous';
        ads.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7295477262076788';
        document.head.appendChild(ads);
      }

      // Load on first interaction or when CPU is idle
      ['scroll', 'mousemove', 'touchstart', 'click', 'keydown'].forEach(function(evt) {
        window.addEventListener(evt, loadScripts, { once: true, passive: true });
      });

      if ('requestIdleCallback' in window) {
        requestIdleCallback(function() { setTimeout(loadScripts, 2500); });
      } else {
        setTimeout(loadScripts, 3000);
      }
    })();
  </script>

