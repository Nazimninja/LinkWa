        style="white-space: nowrap; padding: 8px 14px; border-radius: 20px; font-size: 12.5px; font-weight: 600; cursor: pointer; border: 1.5px solid var(--bd2); background: var(--surf); color: var(--ink2); transition: all 0.15s;"
