    </div>
  </section>

  <!-- FAQ ACCORDION -->
  <section style="margin-bottom: 40px;">
    <h2 style="font-family: var(--font-display); font-size: 24px; font-weight: 700; margin-bottom: 20px; color: var(--ink); text-align: center;">
      Frequently Asked Questions
    </h2>
    <div class="faq-list" style="max-width: 720px; margin: 0 auto;">
      {faqs.map((f, i) => (
        <div class="faq-item" style="border-bottom: 1px solid var(--bd); padding: 14px 0;">
          <div class="faq-q" onclick="toggleFaq(this)" style="font-size: 14.5px; font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; color: var(--ink);">
