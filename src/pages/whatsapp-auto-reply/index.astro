---
import Base from '../../layouts/Base.astro';

const categories = [
  { id: 'away', name: '🌙 Away & After Hours', count: 6 },
  { id: 'greeting', name: '👋 Welcome & Greeting', count: 6 },
  { id: 'pricing', name: '🛍️ Pricing & Catalog', count: 5 },
  { id: 'booking', name: '📅 Appointments & Booking', count: 5 },
  { id: 'support', name: '🛠️ Customer Support', count: 5 },
  { id: 'holiday', name: '🎉 Holiday & Vacation', count: 5 },
];

const faqs = [
  {
    q: "How do I set up an auto reply on WhatsApp Business?",
    a: "Open WhatsApp Business on your phone > Tap the three dots (Android) or Settings (iPhone) > Tap 'Business tools' > Tap 'Away message' or 'Greeting message' > Toggle it ON > Paste your customized message from this generator > Set your schedule and recipients > Tap Save."
  },
  {
    q: "Can I set an auto-reply on personal WhatsApp?",
    a: "WhatsApp does not officially offer automated replies on regular personal accounts. To set automated away or welcome messages, you must upgrade to the free WhatsApp Business app or use an official WhatsApp Business API provider."
  },
  {
    q: "What is the difference between an Away Message and a Greeting Message?",
    a: "A Greeting Message is sent automatically to customers when they message you for the very first time, or after 14 days of no communication. An Away Message is sent only outside your designated business operating hours or when you are unavailable."
  },
  {
    q: "Are these WhatsApp auto-reply templates free to use?",
    a: "Yes! All 30+ message templates on LinkWA are 100% free, ready to copy, and customizable for any business, agency, freelancer, clinic, or online store."
  },
  {
    q: "Can I create a WhatsApp click-to-chat link with an auto-reply pre-filled?",
    a: "Yes! Use the 'Create WhatsApp Link' button on any template below. It transfers your chosen message directly into LinkWA's free link & QR generator so customers can start chatting with one tap."
  }
];
---

<Base
  title="WhatsApp Business Auto Reply Generator (30+ Free Templates) | LinkWA"
  description="Free WhatsApp Business auto-reply generator. 30+ copy-paste away messages, greeting messages, appointment booking, and customer support templates."
  canonical="https://linkwa.in/whatsapp-auto-reply/"
>

<!-- JSON-LD FAQ Schema for Google Search Rich Snippets -->
<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
})} />

<!-- JSON-LD SoftwareApplication Schema -->
<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "LinkWA WhatsApp Auto Reply Generator",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "url": "https://linkwa.in/whatsapp-auto-reply/",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Free generator for WhatsApp Business automated replies, greeting messages, and after-hours away messages."
})} />

<main class="container" style="max-width: 900px; padding: 2rem 1rem 4rem;">
  
  <!-- HERO SECTION -->
  <header style="text-align: center; margin-bottom: 2.5rem;">
