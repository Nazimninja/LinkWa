    <div style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--gm); margin-bottom: 12px; display: flex; align-items: center; gap: 6px;">
      <span>⚙️ Auto-Fill Your Business Details (Optional)</span>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
      <div>
        <label class="lbl" for="bizName" style="font-size: 11px;">Business / Brand Name</label>
        <input type="text" id="bizName" placeholder="e.g. Apex Dental Care" oninput="renderTemplates()" style="font-size: 14px; padding: 8px 12px;" />
      </div>
      <div>
        <label class="lbl" for="bizHours" style="font-size: 11px;">Working Hours</label>
        <input type="text" id="bizHours" placeholder="e.g. 9:00 AM – 6:00 PM (Mon-Sat)" oninput="renderTemplates()" style="font-size: 14px; padding: 8px 12px;" />
      </div>
      <div>
        <label class="lbl" for="bizWebsite" style="font-size: 11px;">Website / Catalog Link</label>
        <input type="text" id="bizWebsite" placeholder="e.g. linkwa.in or yourstore.com" oninput="renderTemplates()" style="font-size: 14px; padding: 8px 12px;" />
      </div>
    </div>
  </section>

  <!-- CATEGORY PILLS -->
  <div style="display: flex; gap: 8px; overflow-x: auto; padding-bottom: 8px; margin-bottom: 20px; scrollbar-width: none; -webkit-overflow-scrolling: touch;">
    {categories.map((c, i) => (
      <button
        type="button"
        class={`cat-pill ${i === 0 ? 'active' : ''}`}
        data-cat={c.id}
