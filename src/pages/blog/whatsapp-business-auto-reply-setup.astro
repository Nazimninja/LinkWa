.article-cta-btn { background: #fff; color: var(--gd); padding: 13px 28px; border-radius: 12px; font-weight: 700; font-size: 15px; text-decoration: none; display: inline-block; font-family: var(--font-display); box-shadow: 0 4px 16px rgba(0,0,0,0.15); transition: transform 0.15s; }
