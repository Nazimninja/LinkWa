.steps-list li { margin-bottom: 10px; line-height: 1.6; font-size: 15px; }

.template-card { background: var(--surface, #fff); border: 1px solid var(--bd); border-radius: 14px; padding: 20px; margin-bottom: 16px; box-shadow: 0 4px 16px rgba(0,0,0,0.04); position: relative; }
.template-badge { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--gm); margin-bottom: 10px; }
.template-body { font-size: 14px; line-height: 1.65; color: var(--ink); background: #f8fafc; border: 1px dashed var(--bd); padding: 14px 16px; border-radius: 10px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; white-space: pre-line; }

.faq-item { background: var(--surface, #fff); border: 1px solid var(--bd); border-radius: 14px; padding: 20px; margin-bottom: 14px; }
.faq-item h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--ink); }
