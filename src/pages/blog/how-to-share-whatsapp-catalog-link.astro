      }
    },
    {
      "@type": "Question",
      "name": "Can I share a link to a single specific product on WhatsApp?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Open WhatsApp Business → Catalog, tap on the specific item, tap the share icon or three dots, and select 'Copy link'. This provides a direct link straight to that item with its photo, price, and description."
      }
    },
    {
      "@type": "Question",
      "name": "Can customers browse my WhatsApp catalog without having my number saved?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. When someone taps a WhatsApp catalog link or scans a catalog QR code, WhatsApp immediately loads your digital storefront inside their app, even if they have never chatted with you or saved your contact."
      }
