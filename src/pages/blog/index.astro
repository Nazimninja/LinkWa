---
import Base from '../../layouts/Base.astro';

const posts = [
  {
    slug: 'how-to-create-whatsapp-link',
    title: 'How to Create a WhatsApp Link for Your Business (2025 Guide)',
    excerpt: 'Learn how to create a WhatsApp click-to-chat link in under 60 seconds. Step-by-step guide with examples for Instagram bio, website, and ads.',
    tag: 'Guide',
    readTime: '5 min read',
    date: 'Jun 15, 2025'
  },
  {
    slug: 'whatsapp-link-instagram-bio',
    title: 'How to Add a WhatsApp Link to Your Instagram Bio',
    excerpt: 'Add a WhatsApp link to your Instagram bio and start getting enquiries directly on WhatsApp. Works for personal and business accounts.',
    tag: 'Instagram',
    readTime: '4 min read',
    date: 'Jun 12, 2025'
  },
  {
    slug: 'whatsapp-qr-code-guide',
    title: 'WhatsApp QR Code: How to Create and Use It for Business',
    excerpt: 'Create a WhatsApp QR code for free and add it to your visiting cards, menus, posters, and store displays. Complete guide with download steps.',
    tag: 'QR Code',
    readTime: '4 min read',
    date: 'Jun 10, 2025'
  },
  {
    slug: 'utm-tracking-whatsapp',
    title: 'UTM Tracking for WhatsApp: Know Which Ad Sends You Leads',
    excerpt: 'Add UTM parameters to your WhatsApp links to track which Instagram ad, Facebook post, or campaign is actually generating your enquiries.',
    tag: 'Marketing',
    readTime: '6 min read',
    date: 'Jun 8, 2025'
  },
  {
    slug: 'wa-me-link-explained',
    title: 'What is a wa.me Link? The Complete Guide for 2025',
    excerpt: 'Everything you need to know about wa.me links — what they are, how they work, the correct format, and how to use them for your business.',
    tag: 'Guide',
    readTime: '5 min read',
    date: 'Jun 5, 2025'
  },
];
---

<Base
  title="Blog – WhatsApp Link Tips & Guides | LinkWA"
  description="Step-by-step guides on using WhatsApp links, QR codes, and UTM tracking to grow your business. Free resources from LinkWA."
>

<div class="blog-hero">
  <div class="container">
    <div class="sec-label">Blog</div>
    <h1 class="blog-hero-title">WhatsApp marketing<br>made simple</h1>
    <p class="blog-hero-sub">Guides, tips, and step-by-step tutorials for businesses that run on WhatsApp.</p>
  </div>
</div>

<section class="blog-main">
  <div class="container">
    <div class="blog-grid">
      {posts.map(post => (
        <a href={`/blog/${post.slug}`} class="blog-card">
          <div class="blog-card-img">
            <svg viewBox="0 0 24 24" fill="none" stroke="#25D366" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/>
            </svg>
          </div>
          <div class="blog-card-body">
            <div class="blog-tag">{post.tag}</div>
            <div class="blog-card-title">{post.title}</div>
            <div class="blog-card-excerpt">{post.excerpt}</div>
            <div class="blog-card-meta">
              <span>{post.date}</span>
              <span>·</span>
              <span>{post.readTime}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

</Base>

<style>
.blog-hero { padding: 4rem 0 2.5rem; text-align: center; }
.blog-hero-title { font-family: var(--font-display); font-size: clamp(28px,5vw,44px); font-weight: 700; letter-spacing: -1.5px; margin: 0.5rem 0 1rem; }
.blog-hero-sub { font-size: 16px; color: var(--ink3); max-width: 400px; margin: 0 auto; line-height: 1.65; }
.blog-main { padding: 1rem 0 5rem; }
</style>
