---

<Base
  title="Blog – WhatsApp Link Tips & Guides | LinkWA"
  description="Step-by-step guides on using WhatsApp links, QR codes, and UTM tracking to grow your business. Free resources from LinkWA."
>

<div class="blog-hero">
  <div class="container">
    <div class="sec-label">Blog</div>
    <h1 class="blog-hero-title">WhatsApp marketing<br>made simple</h1>
    <p class="blog-hero-sub">Guides, tips, and step-by-step tutorials for businesses that run on WhatsApp.</p>
  </div>
</div>

<section class="blog-main">
  <div class="container">
    <div class="blog-grid">
      {posts.map(post => (
        <a href={`/blog/${post.slug}`} class="blog-card">
          <div class="blog-card-img" style={{ background: (categoryMeta[post.tag] || categoryMeta['Guide']).gradient }} set:html={(categoryMeta[post.tag] || categoryMeta['Guide']).svg}>
          </div>
          <div class="blog-card-body">
            <div class="blog-tag">{post.tag}</div>
            <div class="blog-card-title">{post.title}</div>
            <div class="blog-card-excerpt">{post.excerpt}</div>
            <div class="blog-card-meta">
              <span>{post.date}</span>
              <span>·</span>
              <span>{post.readTime}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

</Base>

<style>
.blog-hero { padding: 4rem 0 2.5rem; text-align: center; }
.blog-hero-title { font-family: var(--font-display); font-size: clamp(28px,5vw,44px); font-weight: 700; letter-spacing: -1.5px; margin: 0.5rem 0 1rem; }
.blog-hero-sub { font-size: 16px; color: var(--ink3); max-width: 400px; margin: 0 auto; line-height: 1.65; }
.blog-main { padding: 1rem 0 5rem; }
</style>
