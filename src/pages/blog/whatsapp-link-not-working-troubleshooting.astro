  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why does WhatsApp say 'The phone number shared via url is invalid'?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "This error happens when the URL contains illegal characters like a plus sign (+), spaces, dashes, or leading zeros. The official wa.me format requires purely continuous digits: country code followed by phone number (e.g., wa.me/14155552671)."
      }
    },
    {
      "@type": "Question",
      "name": "Why is my WhatsApp link not opening on Instagram or TikTok?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Social media in-app browsers often restrict external protocol redirects. Using a direct wa.me link or a clean short URL like linkwa.in/yourbrand ensures the browser properly hands off the click to the native WhatsApp app."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to include a plus sign (+) in a wa.me WhatsApp link?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No! Never include the '+' symbol. WhatsApp's link API requires the number without symbols. For example, use 'https://wa.me/919876543210' instead of 'https://wa.me/+919876543210'."
      }
    },
    {
      "@type": "Question",
      "name": "Why is my pre-filled message cutting off or showing weird characters?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "WhatsApp URLs require URL encoding (percent-encoding) for spaces, commas, emojis, and line breaks. For instance, spaces must be encoded as '%20'. LinkWA handles this encoding automatically."
      }
