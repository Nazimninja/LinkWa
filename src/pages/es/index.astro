---
import Base from '../../layouts/Base.astro';

const faqs = [
  {
    q: "¿Cómo crear un enlace de WhatsApp con mensaje personalizado?",
    a: "Escribe tu número de teléfono con el código de tu país (ej. +34 para España, +52 para México), redacta el mensaje de saludo que deseas recibir y haz clic en 'Generar Enlace de WhatsApp'. ¡Listo para copiar o compartir!"
  },
  {
    q: "¿El generador de enlaces de WhatsApp es realmente gratis?",
    a: "Sí, LinkWA es 100% gratuito, sin necesidad de registro, sin límites de uso y sin publicidad invasiva. Además, incluye la descarga de códigos QR en alta resolución (1000px)."
  },
  {
    q: "¿Cómo funciona un enlace wa.me?",
    a: "Un enlace wa.me es el formato oficial de WhatsApp para 'Clic para Chatear'. Permite que cualquier persona inicie una conversación contigo con un solo toque, sin necesidad de guardar tu número de teléfono en sus contactos."
  },
  {
    q: "¿Puedo poner mi propio logo en el código QR de WhatsApp?",
    a: "¡Sí! En el estudio de códigos QR de LinkWA puedes subir el logo de tu empresa o marca. La herramienta recorta y limpia automáticamente el fondo blanco para que tu QR se vea impecable en volantes, cartas de menú y stands."
  },
  {
    q: "¿Se guardan mis números de teléfono o mensajes en sus servidores?",
    a: "No. LinkWA procesa todo al 100% en tu navegador de forma local. Nunca recopilamos, almacenamos ni compartimos tus números de teléfono ni la información de tus clientes."
  }
];
---

<Base
  title="Generador de Enlaces de WhatsApp con Código QR Gratis | LinkWA"
  description="Crea enlaces directos de WhatsApp (wa.me) con mensaje personalizado y código QR con tu logo gratis. Sin registro, rápido y 100% privado."
  canonical="https://linkwa.in/es/"
  lang="es"
>

<!-- JSON-LD FAQ Schema -->
<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
})} />

<!-- HERO -->
<div class="hero">
  <div class="hero-header-badges">
    <div class="hero-chip"><span class="hero-chip-dot"></span> 100% Gratis · Sin Registro</div>
  </div>
  <h1>Generador de <strong>Enlaces de WhatsApp</strong> con Código QR</h1>
  <p class="hero-sub">Crea enlaces directos wa.me con mensajes personalizados y códigos QR instantáneos para imprimir. Gratis, sin registro y seguro.</p>
  <div class="hero-stats">
    <div class="hstat"><div class="hstat-n">2B+</div><div class="hstat-l">Usuarios globales</div></div>
    <div class="hstat"><div class="hstat-n">wa.me</div><div class="hstat-l">Formato oficial</div></div>
    <div class="hstat"><div class="hstat-n">Gratis</div><div class="hstat-l">Para siempre</div></div>
  </div>
</div>

<!-- TABS -->
<div class="tab-wrap">
  <div class="tab-bar">
    <button class="tab active" onclick="switchTab('basic',this)">Enlace Directo</button>
    <button class="tab" onclick="switchTab('utm',this)">Rastreo UTM</button>
    <button class="tab" onclick="switchTab('group',this)">Código QR Grupo</button>
  </div>
</div>

<!-- TOOL GRID -->
<div class="tool-grid">

  <!-- LEFT: INPUT -->
  <div>
    <div class="card">
      <div class="card-head">
        <div class="ch-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="#25D366" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        </div>
        <div>
          <div class="ch-title" id="formCardTitle">Tus datos</div>
          <div class="ch-sub" id="formCardSub">Ingresa tu número y mensaje predefinido</div>
        </div>
      </div>

      <!-- BASIC PANEL -->
      <div id="panel-basic" class="panel active">
        <div class="field">
          <label class="lbl" for="phone">Número de teléfono</label>
          <div class="row">
            <select id="cc" aria-label="Código de país">
              <option value="34">🇪🇸 +34 (España)</option>
              <option value="52">🇲🇽 +52 (México)</option>
              <option value="57">🇨🇴 +57 (Colombia)</option>
              <option value="54">🇦🇷 +54 (Argentina)</option>
              <option value="56">🇨🇱 +56 (Chile)</option>
              <option value="51">🇵🇪 +51 (Perú)</option>
              <option value="593">🇪🇨 +593 (Ecuador)</option>
              <option value="1">🇺🇸 +1 (EE. UU.)</option>
              <option value="91">🇮🇳 +91 (India)</option>
            </select>
            <input type="tel" id="phone" placeholder="612 345 678" oninput="live()" />
          </div>
          <div class="hint">Sin el código de país ni espacios</div>
        </div>
        <div class="field">
          <label class="lbl" for="msg">Mensaje predeterminado <span class="opt">(opcional)</span></label>
          <div class="emoji-toolbar">
            <button type="button" class="emoji-btn" onclick="insertEmoji('👋', 'msg')" aria-label="Insertar emoji">👋</button>
            <button type="button" class="emoji-btn" onclick="insertEmoji('😊', 'msg')" aria-label="Insertar emoji">😊</button>
            <button type="button" class="emoji-btn" onclick="insertEmoji('💬', 'msg')" aria-label="Insertar emoji">💬</button>
            <button type="button" class="emoji-btn" onclick="insertEmoji('🛍️', 'msg')" aria-label="Insertar emoji">🛍️</button>
            <button type="button" class="emoji-btn" onclick="insertEmoji('📞', 'msg')" aria-label="Insertar emoji">📞</button>
            <button type="button" class="emoji-btn" onclick="insertEmoji('✨', 'msg')" aria-label="Insertar emoji">✨</button>
            <button type="button" class="emoji-btn" onclick="insertEmoji('✅', 'msg')" aria-label="Insertar emoji">✅</button>
            <button type="button" class="emoji-btn" onclick="insertEmoji('👍', 'msg')" aria-label="Insertar emoji">👍</button>
          </div>
          
          <div class="template-pills" style="display:flex; flex-wrap:wrap; gap:6px; margin: 6px 0 8px 0;">
            <button type="button" class="pill-btn" onclick="applyTemplate('¡Hola! Vi su publicación y me gustaría solicitar información.')" style="background:rgba(255,255,255,0.06); border:1px solid var(--bd2); border-radius:14px; padding:4px 10px; font-size:11px; color:var(--ink2); cursor:pointer;">⚡ Consulta General</button>
            <button type="button" class="pill-btn" onclick="applyTemplate('¡Hola! ¿Podrían compartir su catálogo de productos y precios?')" style="background:rgba(255,255,255,0.06); border:1px solid var(--bd2); border-radius:14px; padding:4px 10px; font-size:11px; color:var(--ink2); cursor:pointer;">🛍️ Catálogo y Precios</button>
            <button type="button" class="pill-btn" onclick="applyTemplate('¡Hola! Quiero agendar una cita o consulta.')" style="background:rgba(255,255,255,0.06); border:1px solid var(--bd2); border-radius:14px; padding:4px 10px; font-size:11px; color:var(--ink2); cursor:pointer;">📅 Agendar Cita</button>
          </div>
          <textarea id="msg" placeholder="¡Hola! Me gustaría más información sobre..." oninput="live();cnt(this,'mc')"></textarea>
          <div class="char-count" id="mc">0 / 500</div>
          <div class="hint">El cliente verá este mensaje listo al tocar tu enlace · <a href="/whatsapp-auto-reply/" style="color: var(--gm); font-weight: 600; text-decoration: none;">Ver plantillas de respuesta automática →</a></div>
        </div>
      </div>

      <!-- UTM PANEL -->
      <div id="panel-utm" class="panel">
        <div class="field">
          <label class="lbl" for="uphone">Número de teléfono</label>
          <div class="row">
            <select id="ucc" aria-label="Código de país">
              <option value="34">🇪🇸 +34</option>
              <option value="52">🇲🇽 +52</option>
              <option value="57">🇨🇴 +57</option>
              <option value="54">🇦🇷 +54</option>
              <option value="56">🇨🇱 +56</option>
              <option value="51">🇵🇪 +51</option>
              <option value="1">🇺🇸 +1</option>
            </select>
            <input type="tel" id="uphone" placeholder="612 345 678" oninput="live()" />
          </div>
        </div>
        <div class="field">
          <label class="lbl" for="umsg">Mensaje predeterminado <span class="opt">(opcional)</span></label>
          <textarea id="umsg" placeholder="¡Hola! Vengo desde su anuncio de Instagram..." oninput="live()" style="min-height:68px;"></textarea>
        </div>
        <div class="utm-block">
          <div class="utm-grid">
            <div><label class="lbl" for="us" style="color:var(--gm);">Source (Origen)</label><input id="us" placeholder="instagram" oninput="live()" /></div>
            <div><label class="lbl" for="um" style="color:var(--gm);">Medium (Medio)</label><input id="um" placeholder="social" oninput="live()" /></div>
            <div><label class="lbl" for="uc" style="color:var(--gm);">Campaign (Campaña)</label><input id="uc" placeholder="oferta-verano" oninput="live()" /></div>
            <div><label class="lbl" for="uk" style="color:var(--gm);">Content (Contenido)</label><input id="uk" placeholder="anuncio-1" oninput="live()" /></div>
          </div>
          <div class="hint" style="margin-top:10px;">Rastrea exactamente qué campaña publicitaria genera tus conversaciones de WhatsApp</div>
        </div>
      </div>

      <!-- GROUP PANEL -->
      <div id="panel-group" class="panel">
        <div class="field">
          <label class="lbl" for="groupLink">Enlace de invitación al grupo</label>
          <input type="url" id="groupLink" placeholder="https://chat.whatsapp.com/..." oninput="live()" />
          <div class="hint">Pega tu enlace de invitación a grupo o comunidad de WhatsApp</div>
        </div>
        <div class="field">
          <label class="lbl" for="groupName">Nombre del grupo <span class="opt">(opcional)</span></label>
          <input type="text" id="groupName" placeholder="Ej. Miembros Gimnasio, Club VIP" oninput="live()" />
        </div>
      </div>

      <button class="btn-gen" id="btnGen" onclick="generate()">
        <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        <span>Generar Enlace de WhatsApp</span>
      </button>

      <!-- INLINE OUTPUT (FOR MOBILE) -->
      <div id="inline-output" style="display: none; margin-top: 20px; padding-top: 20px; border-top: 1px dashed var(--bd2); text-align: left;">
        <div class="card-head" style="border-bottom:none; margin-bottom:10px; padding-bottom:0; display: flex; align-items: center; gap: 10px;">
          <div class="ch-icon" style="background:var(--gl); border-radius:10px; width:34px; height:34px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--g)" stroke-width="2.5" style="width:18px;height:18px;"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <div class="ch-title" style="color: var(--gm); font-weight: 700; font-size:14px; margin-bottom: 2px;">¡Enlace Generado!</div>
            <div class="ch-sub" style="font-size:11.5px; color:var(--ink3);">Copia el enlace para compartirlo</div>
          </div>
        </div>
        
        <div id="inline-single-area">
          <div class="result-wrap" style="background: var(--gl); border: 2.5px solid var(--g); border-radius: 12px; padding: 12px; display: flex; align-items: center; gap: 10px; margin-bottom: 12px; min-height: 52px; box-shadow: 0 4px 12px rgba(37,211,102,0.08);">
            <span class="result-url" id="inline-rurl" style="flex:1; font-family:var(--font-mono); font-size:13.5px; color:var(--gd); word-break:break-all; font-weight:600; line-height:1.4;"></span>
            <button class="copy-btn" id="inline-cpbtn" onclick="copyInlineLink()" style="background: var(--g); color: white; border: none; padding: 10px 18px; border-radius: 8px; font-weight: 700; cursor: pointer; transition: background 0.15s; font-family: var(--font-body); min-height: 44px; font-size:13.5px; flex-shrink:0;" aria-label="Copiar enlace">Copiar</button>
          </div>

          <div class="act-row" style="display: flex; gap: 10px; margin-top: 8px;">
            <button class="act-btn" onclick="testInlineLink()" style="flex:1; display:flex; align-items:center; justify-content:center; gap:6px; padding:10px; border:1.5px solid var(--bd2); border-radius:10px; background:transparent; font-family:var(--font-body); font-size:12.5px; font-weight:600; color:var(--ink2); cursor:pointer;">
              Probar Enlace ↗
            </button>
            <button class="act-btn" onclick="shareInlineLink()" style="flex:1; display:flex; align-items:center; justify-content:center; gap:6px; padding:10px; border:1.5px solid var(--bd2); border-radius:10px; background:transparent; font-family:var(--font-body); font-size:12.5px; font-weight:600; color:var(--ink2); cursor:pointer;">
              Compartir 📲
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- RIGHT: OUTPUT & QR STUDIO -->
  <div>
    <div class="card desktop-only-card">
      <div class="card-head">
        <div class="ch-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="#25D366" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
        </div>
        <div>
          <div class="ch-title" id="desktopCardTitle">Tu enlace de WhatsApp</div>
          <div class="ch-sub" id="desktopCardSub">Listo para copiar y compartir</div>
        </div>
      </div>
      
      <div id="desktop-single-area">
        <div class="result-wrap">
          <span class="result-url empty" id="rurl">Tu enlace aparecerá aquí al generarlo...</span>
          <button class="copy-btn" id="cpbtn" onclick="copyLink()" aria-label="Copiar enlace">Copiar</button>
        </div>
        <div class="act-row">
          <button class="act-btn" onclick="testLink()" aria-label="Probar enlace">Probar enlace ↗</button>
          <button class="act-btn" onclick="shareLink()" aria-label="Compartir enlace">Compartir 📲</button>
        </div>
      </div>
    </div>

    <!-- QR CODE STUDIO CARD -->
    <div class="card">
      <div class="card-head" style="justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
        <div style="display: flex; align-items: center; gap: 11px;">
          <div class="ch-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#25D366" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path stroke-linecap="round" d="M14 14h1m2 0h2m-2 2v2m2-2v4m-4 0h2"/></svg>
          </div>
          <div>
            <div class="ch-title">Estudio de Código QR</div>
            <div class="ch-sub">Listo para imprimir en menús y stands</div>
          </div>
        </div>
      </div>

      <div class="qr-area">
        <div class="qr-frame" id="qrFrame">
          <p class="qr-ph" id="qrPh">Genera un enlace para ver tu código QR</p>
          <div id="qr-target"></div>
          <div class="qr-center-logo" id="qrLogo">
            <svg viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2.07 21.5l4.432-1.343A9.956 9.956 0 0012 22c5.523 0 10-4.477 10-10S17.522 2 12 2zm0 18.182a8.173 8.173 0 01-4.168-1.143l-.3-.178-3.1.939.892-3.232-.196-.315A8.18 8.18 0 013.818 12c0-4.513 3.669-8.182 8.182-8.182 4.512 0 8.181 3.669 8.181 8.182 0 4.513-3.669 8.182-8.182 8.182z"/></svg>
          </div>
        </div>
        <button class="btn-dl" id="dlBtn" onclick="downloadQR()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          Descargar Código QR (HD 1000px)
        </button>
      </div>
    </div>
  </div>

</div>

<!-- FAQ SECTION -->
<section class="container faq-section" style="max-width: 760px; margin: 3.5rem auto 1rem; padding: 0 12px;">
  <h2 style="font-family: var(--font-display); font-size: 24px; font-weight: 700; text-align: center; margin-bottom: 24px; color: var(--ink);">
    Preguntas Frecuentes
  </h2>
  {faqs.map(f => (
    <div class="faq-item" style="border-bottom: 1px solid var(--bd); padding: 14px 0;">
      <div class="faq-q" onclick="this.nextElementSibling.classList.toggle('open')" style="font-size: 14.5px; font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center; color: var(--ink);">
        <span>{f.q}</span>
        <span style="font-size: 18px; color: var(--gm); font-weight: 700;">+</span>
      </div>
      <div class="faq-a" style="font-size: 13.5px; color: var(--ink2); line-height: 1.6; margin-top: 8px;">
        {f.a}
      </div>
    </div>
  ))}
</section>

<script is:inline src="/qrcode.min.js">
// Read URL query parameters to auto-fill inputs (?msg=..., ?text=..., ?phone=..., ?cc=...)
function initFromUrlParams() {
  try {
    const params = new URLSearchParams(window.location.search);
    const msg = params.get('msg') || params.get('text');
    const phone = params.get('phone') || params.get('number');
    const cc = params.get('cc');

    if (msg) {
      const msgEl = document.getElementById('msg');
      if (msgEl) {
        msgEl.value = msg;
        cnt(msgEl, 'mc');
      }
      const umsgEl = document.getElementById('umsg');
      if (umsgEl) umsgEl.value = msg;
    }
    if (phone) {
      const cleanPhone = phone.replace(/\D/g, '');
      const phoneEl = document.getElementById('phone');
      if (phoneEl) phoneEl.value = cleanPhone;
      const uphoneEl = document.getElementById('uphone');
      if (uphoneEl) uphoneEl.value = cleanPhone;
    }
    if (cc) {
      const ccEl = document.getElementById('cc');
      if (ccEl && [...ccEl.options].some(o => o.value === cc)) ccEl.value = cc;
      const uccEl = document.getElementById('ucc');
      if (uccEl && [...uccEl.options].some(o => o.value === cc)) uccEl.value = cc;
    }
    live();
    if (phone) {
      generate();
    }
  } catch (e) {
    console.debug('URL params init error:', e);
  }
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initFromUrlParams);
} else {
  initFromUrlParams();
}

</script>
<script is:inline>
let tab = 'basic', curUrl = '';

function switchTab(t, btn) {
  tab = t;
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(b => b.classList.remove('active'));
  document.getElementById('panel-' + t).classList.add('active');
  btn.classList.add('active');
  live();
}

function buildUrl() {
  if (tab === 'basic') {
    const c = document.getElementById('cc').value;
    const p = document.getElementById('phone').value.replace(/\D/g,'');
    const m = document.getElementById('msg').value.trim();
    if (!p) return '';
    let u = 'https://wa.me/' + c + p;
    if (m) u += '?text=' + encodeURIComponent(m);
    return u;
  }
  if (tab === 'utm') {
    const c = document.getElementById('ucc').value;
    const p = document.getElementById('uphone').value.replace(/\D/g,'');
    let m = document.getElementById('umsg').value.trim();
    if (!p) return '';
    const us = (document.getElementById('us').value||'').trim();
    const um = (document.getElementById('um').value||'').trim();
    const uc = (document.getElementById('uc').value||'').trim();
    const uk = (document.getElementById('uk').value||'').trim();
    let tags = [];
    if (us) tags.push('utm_source=' + encodeURIComponent(us));
    if (um) tags.push('utm_medium=' + encodeURIComponent(um));
    if (uc) tags.push('utm_campaign=' + encodeURIComponent(uc));
    if (uk) tags.push('utm_content=' + encodeURIComponent(uk));
    let u = 'https://wa.me/' + c + p;
    if (m) u += '?text=' + encodeURIComponent(m);
    if (tags.length) u += (m ? '&' : '?') + tags.join('&');
    return u;
  }
  if (tab === 'group') {
    const raw = (document.getElementById('groupLink')?.value || '').trim();
    if (!raw) return '';
    return raw.startsWith('http') ? raw : 'https://' + raw;
  }
  return '';
}

function live() {
  const url = buildUrl();
  curUrl = url;
  const el = document.getElementById('rurl');
  if (url) { el.className = 'result-url'; el.textContent = url; }
  else { el.className = 'result-url empty'; el.textContent = 'Tu enlace aparecerá aquí al generarlo...'; }
}

function cnt(el, id) { document.getElementById(id).textContent = el.value.length + ' / 500'; }

function insertEmoji(em, targetId) {
  const input = document.getElementById(targetId);
  if (!input) return;
  input.value += em;
  live();
}

function applyTemplate(txt) {
  const msgInput = document.getElementById('msg');
  if (msgInput) {
    msgInput.value = txt;
    cnt(msgInput, 'mc');
    live();
  }
}

function showInlineSingle(url) {
  const inlineOut = document.getElementById('inline-output');
  const inlineUrl = document.getElementById('inline-rurl');
  if (inlineOut && inlineUrl && url) {
    inlineUrl.textContent = url;
    inlineOut.style.display = 'block';
    if (window.innerWidth <= 768) {
      inlineOut.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }
}

function copyLink() {
  if (!curUrl) return;
  navigator.clipboard.writeText(curUrl).then(() => {
    const btn = document.getElementById('cpbtn');
    if (btn) btn.textContent = '¡Copiado! ✓';
    if (window.toast) window.toast('¡Enlace copiado al portapapeles!');
    setTimeout(() => { if (btn) btn.textContent = 'Copiar'; }, 2000);
  });
}

function copyInlineLink() {
  if (!curUrl) return;
  navigator.clipboard.writeText(curUrl).then(() => {
    const btn = document.getElementById('inline-cpbtn');
    if (btn) btn.textContent = '¡Copiado! ✓';
    if (window.toast) window.toast('¡Enlace copiado al portapapeles!');
    setTimeout(() => { if (btn) btn.textContent = 'Copiar'; }, 2000);
  });
}

function testLink() { if (curUrl) window.open(curUrl, '_blank'); }
function testInlineLink() { if (curUrl) window.open(curUrl, '_blank'); }

function shareLink() {
  if (!curUrl) return;
  if (navigator.share) { navigator.share({ title: 'Mi Enlace de WhatsApp', url: curUrl }); }
  else { copyLink(); }
}
function shareInlineLink() {
  if (!curUrl) return;
  if (navigator.share) { navigator.share({ title: 'Mi Enlace de WhatsApp', url: curUrl }); }
  else { copyInlineLink(); }
}

function renderQR(url) {
  const frame = document.getElementById('qrFrame');
  const target = document.getElementById('qr-target');
  const logo = document.getElementById('qrLogo');
  const dl = document.getElementById('dlBtn');
  const ph = document.getElementById('qrPh');
  if (!url) {
    target.style.display = 'none';
    logo.style.display = 'none';
    dl.style.display = 'none';
    ph.style.display = 'block';
    frame.className = 'qr-frame';
    return;
  }
  target.innerHTML = '';
  new QRCode(target, {
    text: url,
    width: 152,
    height: 152,
    colorDark: '#080f0d',
    colorLight: '#ffffff',
    correctLevel: QRCode.CorrectLevel.H
  });
  target.style.display = 'block';
  logo.style.display = 'flex';
  ph.style.display = 'none';
  frame.className = 'qr-frame ready';
  dl.style.display = 'inline-flex';
}

function downloadQR() {
  if (!curUrl) return;
  const offscreen = document.createElement('div');
  new QRCode(offscreen, {
    text: curUrl,
    width: 1000,
    height: 1000,
    colorDark: '#080f0d',
    colorLight: '#ffffff',
    correctLevel: QRCode.CorrectLevel.H
  });
  setTimeout(() => {
    const canvas = offscreen.querySelector('canvas');
    if (!canvas) return;
    const link = document.createElement('a');
    link.download = 'whatsapp-qr-linkwa.png';
    link.href = canvas.toDataURL('image/png');
    link.click();
  }, 100);
}

function generate() {
  live();
  if (!curUrl) {
    alert(tab === 'group' ? 'Por favor pega el enlace de tu grupo' : 'Por favor ingresa un número de teléfono');
    return;
  }
  renderQR(curUrl);
  showInlineSingle(curUrl);
}
</script>
