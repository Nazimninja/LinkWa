---
import Base from '../layouts/Base.astro';
---
<Base title="Contact Us | LinkWA" description="Get in touch with the LinkWA team. Send us your feedback, report bugs, or partner with us.">
<div class="container" style="max-width:680px;padding-top:4rem;padding-bottom:5rem;">
  <div class="prose">
    <h1>Contact Us</h1>
    <p>Have any questions, feedback, or feature requests? We would love to hear from you. Choose your preferred contact method below.</p>
    
    <div style="display:grid;grid-template-columns:1fr;gap:20px;margin-top:2rem;margin-bottom:2.5rem;">
      
      <!-- WhatsApp Support Card -->
      <div class="card" style="border: 1px solid var(--bd2); border-left: 4px solid var(--g);">
        <div class="card-head" style="border-bottom:none; margin-bottom:0;">
          <div class="ch-icon" style="background:#e8faf1;"><svg viewBox="0 0 24 24" fill="var(--gm)"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.513 2.262 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.458L0 24zm6.59-3.859c1.652.981 3.271 1.497 5.174 1.498 5.679 0 10.301-4.573 10.304-10.198.002-2.723-1.055-5.283-2.977-7.21C17.228 2.294 14.674 1.235 12 1.232c-5.7 0-10.323 4.577-10.327 10.203-.001 1.995.526 3.652 1.54 5.148L2.247 21.75l6.4-1.609z"/></svg></div>
          <div>
            <div class="ch-title">WhatsApp Support</div>
            <div class="ch-sub">Send an instant WhatsApp message to our team</div>
          </div>
        </div>
        
        <form onsubmit="event.preventDefault(); sendWhatsAppSupport();" style="margin-top:14px;">
          <div class="field">
            <label class="lbl">Your Name</label>
            <input type="text" id="contact-name" placeholder="John Doe" required style="width:100%;" />
          </div>
          
          <div class="field">
            <label class="lbl">Reason for Contact</label>
            <select id="contact-reason" style="width:100%;">
              <option value="General Query">General Inquiry</option>
              <option value="Feature Request">Feature Request</option>
              <option value="Bug Report">Bug Report</option>
              <option value="Business Partnership">Business Partnership</option>
            </select>
          </div>
          
          <div class="field">
            <label class="lbl">Message Detail</label>
            <textarea id="contact-msg" placeholder="Tell us more about how we can help you..." required style="width:100%; min-height:80px;"></textarea>
          </div>
          
          <button type="submit" class="btn-gen" style="width:100%; margin-top:8px;">
            Send via WhatsApp
          </button>
        </form>
      </div>

      <!-- Email Card -->
      <div class="card" style="border: 1px solid var(--bd2); border-left: 4px solid var(--gm);">
        <div class="card-head" style="border-bottom:none; margin-bottom:0;">
          <div class="ch-icon" style="background:#e8f4fa;"><svg viewBox="0 0 24 24" fill="none" stroke="var(--gm)" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg></div>
          <div>
            <div class="ch-title">Email Inquiries</div>
            <div class="ch-sub">For business collaborations and official requests</div>
          </div>
        </div>
        <p style="font-size: 14px; color: var(--ink2); margin-top: 12px; line-height: 1.6;">
          You can send an email directly to our support desk. We typically respond within 24 to 48 hours:
          <br />
          <a href="mailto:support@linkwa.in" style="display:inline-block; font-weight:600; color:var(--gm); margin-top:8px; text-decoration:none;">support@linkwa.in</a>
        </p>
      </div>

    </div>
  </div>
</div>

<script is:inline>
function sendWhatsAppSupport() {
  const name = document.getElementById('contact-name').value;
  const reason = document.getElementById('contact-reason').value;
  const msg = document.getElementById('contact-msg').value;
  
  const text = `Hi LinkWA Team! My name is ${name}. I am contacting you regarding: [${reason}].\n\nDetails: ${msg}`;
  const encoded = encodeURIComponent(text);
  
  // Open WhatsApp with support number (e.g. 919876543210 placeholder)
  const url = `https://wa.me/919876543210?text=${encoded}`;
  window.open(url, '_blank');
}
</script>
</Base>
